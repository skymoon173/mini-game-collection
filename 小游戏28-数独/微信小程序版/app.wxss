/* app.wxss */
/* 全局样式变量 */
:root {
  --primary-gradient-start: #667eea;
  --primary-gradient-end: #764ba2;
  --secondary-gradient-start: #f093fb;
  --secondary-gradient-end: #f5576c;
  --success-gradient-start: #4facfe;
  --success-gradient-end: #00f2fe;
  --warning-gradient-start: #fa709a;
  --warning-gradient-end: #fee140;
  --dark-gradient-start: #2c3e50;
  --dark-gradient-end: #34495e;

  --primary-color: #667eea;
  --secondary-color: #764ba2;
  --success-color: #4facfe;
  --warning-color: #fa709a;
  --danger-color: #e74c3c;
  --dark-color: #2c3e50;

  --bg-primary: #f8f9fa;
  --bg-secondary: #ffffff;
  --bg-dark: #1a1a2e;
  --bg-darker: #16213e;

  --text-primary: #2c3e50;
  --text-secondary: #6c757d;
  --text-light: #ffffff;

  --border-radius: 12rpx;
  --shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  --shadow-hover: 0 12rpx 40rpx rgba(0, 0, 0, 0.15);
  --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 全局样式 */
.container {
  padding: 20rpx;
  background: var(--bg-primary);
  min-height: 100vh;
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
  color: white;
  border: none;
  border-radius: var(--border-radius);
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx 48rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--shadow);
  transition: var(--transition);
}

.btn-primary:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-hover);
}

.btn-secondary {
  background: var(--bg-secondary);
  color: var(--text-primary);
  border: 2rpx solid rgba(0, 0, 0, 0.1);
  border-radius: var(--border-radius);
  font-size: 32rpx;
  font-weight: 500;
  padding: 24rpx 48rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: var(--shadow);
  transition: var(--transition);
}

.btn-secondary:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-hover);
}

/* 模态框样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: var(--transition);
  backdrop-filter: blur(10rpx);
}

.modal.open {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: var(--bg-secondary);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow);
  max-width: 600rpx;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  animation: modalSlideIn 0.5s ease-out;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 48rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.1);
  background: linear-gradient(135deg, var(--primary-gradient-start), var(--primary-gradient-end));
  color: white;
  border-radius: var(--border-radius) var(--border-radius) 0 0;
}

.modal-header h3 {
  margin: 0;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.modal-close {
  background: none;
  border: none;
  color: white;
  font-size: 36rpx;
  cursor: pointer;
  padding: 10rpx;
  border-radius: 50%;
  transition: var(--transition);
}

.modal-close:active {
  background: rgba(255, 255, 255, 0.2);
}

.modal-body {
  padding: 48rpx;
}

/* 动画 */
@keyframes modalSlideIn {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(-40rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 加载动画 */
.loading-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 10;
  border-radius: var(--border-radius);
}

.loading-spinner {
  text-align: center;
  color: var(--primary-color);
}

.loading-spinner i {
  font-size: 60rpx;
  margin-bottom: 20rpx;
  display: block;
  animation: spin 1s linear infinite;
}

.loading-spinner span {
  font-size: 28rpx;
  font-weight: 500;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 粒子效果 */
.particle {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  background: var(--success-color);
  border-radius: 50%;
  pointer-events: none;
  animation: particle 1s ease-out forwards;
}

@keyframes particle {
  0% {
    opacity: 1;
    transform: scale(0) rotate(0deg);
  }
  50% {
    opacity: 0.8;
    transform: scale(1) rotate(180deg);
  }
  100% {
    opacity: 0;
    transform: scale(2) rotate(360deg);
  }
}
